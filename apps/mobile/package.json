{
  "name": "@clearhead/mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "build": "expo export --platform all",
    "cloud:build:ios": "npx eas-cli build --platform ios",
    "cloud:build:android": "npx eas-cli build --platform android",
    "local:build:ios": "expo run:ios",
    "local:build:android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@supabase/supabase-js": "^2.57.4",
    "@clearhead/domain": "*",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.0",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.19",
    "expo-notifications": "~57.0.0",
    "expo-router": "~57.0.21",
    "expo-speech-recognition": "^57.0.0",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-secure-store": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": { "@types/react": "~19.2.0", "typescript": "~5.9.2" }
}
