{
  "name": "@veylo/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "test:ai-interpretation": "node --experimental-strip-types --test test/ai-interpretation.test.ts",
    "test:google-contract": "node --experimental-strip-types --test test/google-freebusy.test.ts test/google-event.test.ts",
    "test:jira-contract": "node --experimental-strip-types --test test/jira-issues.test.ts",
    "test:notion-contract": "node --experimental-strip-types --test test/notion-pagination.test.ts",
    "test:supabase-key": "node --experimental-strip-types --test test/supabase-admin-key.test.ts",
    "test:integration": "npm run build -w @veylo/domain && npm run build -w @veylo/db && tsx --test test/integration/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@supabase/supabase-js": "^2.57.4",
    "@veylo/db": "*",
    "@veylo/domain": "*",
    "@xmldom/xmldom": "0.8.15",
    "bullmq": "^5.58.5",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
