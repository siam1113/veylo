# API and worker (server-side secrets stay here; never use VITE_/EXPO_PUBLIC_ for secrets)
NODE_ENV=development
PORT=4100
WEB_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5174,http://127.0.0.1:5174
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET_KEY
# Legacy compatibility only; prefer SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SUPABASE_SERVICE_ROLE_KEY
# Copy the database URI from Supabase Dashboard > Connect. Replace its password placeholder.
# Use the Session pooler URI if the direct database host is unreachable from your network.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_DB_HOST:5432/postgres?sslmode=require
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_REDIS_HOST:6379
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:4100/v1/integrations/google/callback
JIRA_CLIENT_ID=YOUR_ATLASSIAN_OAUTH_CLIENT_ID
JIRA_CLIENT_SECRET=YOUR_ATLASSIAN_OAUTH_CLIENT_SECRET
JIRA_REDIRECT_URI=http://localhost:4100/v1/integrations/jira/callback
NOTION_CLIENT_ID=YOUR_NOTION_PUBLIC_CONNECTION_CLIENT_ID
NOTION_CLIENT_SECRET=YOUR_NOTION_PUBLIC_CONNECTION_CLIENT_SECRET
NOTION_REDIRECT_URI=http://localhost:4100/v1/integrations/notion/callback
# Optional Outlook connection
OUTLOOK_CLIENT_ID=YOUR_OUTLOOK_OAUTH_CLIENT_ID
OUTLOOK_CLIENT_SECRET=YOUR_OUTLOOK_OAUTH_CLIENT_SECRET
OUTLOOK_REDIRECT_URI=http://localhost:4100/v1/integrations/outlook/callback
# Optional Clickup connection
CLICKUP_CLIENT_ID=YOUR_CLICKUP_OAUTH_CLIENT_ID
CLICKUP_CLIENT_SECRET=YOUR_CLICKUP_OAUTH_CLIENT_SECRET
CLICKUP_REDIRECT_URI=http://localhost:4100/v1/integrations/clickup/callback
# Optional Asana connection
ASANA_CLIENT_ID=YOUR_ASANA_OAUTH_CLIENT_ID
ASANA_CLIENT_SECRET=YOUR_ASANA_OAUTH_CLIENT_SECRET
ASANA_REDIRECT_URI=http://localhost:4100/v1/integrations/asana/callback
# Optional Trello connection
TRELLO_CLIENT_ID=YOUR_TRELLO_OAUTH_CLIENT_ID
TRELLO_CLIENT_SECRET=YOUR_TRELLO_OAUTH_CLIENT_SECRET
TRELLO_REDIRECT_URI=http://localhost:4100/v1/integrations/trello/callback
# Optional todoist connection
TODOIST_CLIENT_ID=YOUR_TODOIST_CLIENT_ID
TODOIST_CLIENT_SECRET=YOUR_TODOIST_CLIENT_SECRET
TODOIST_REDIRECT_URI=http://localhost:4100/v1/integrations/todoist/callback
# Optional microsoft todo connection
MICROSOFT_TODO_CLIENT_ID=YOUR_MICROSOFT_TODO_CLIENT_ID
MICROSOFT_TODO_CLIENT_SECRET=YOUR_MICROSOFT_TODO_CLIENT_SECRET
MICROSOFT_TODO_REDIRECT_URI=http://localhost:4100/v1/integrations/microsoft_todo/callback
# Optional linear connection
LINEAR_CLIENT_ID=YOUR_LINEAR_CLIENT_ID
LINEAR_CLIENT_SECRET=YOUR_LINEAR_CLIENT_SECRET
LINEAR_REDIRECT_URI=http://localhost:4100/v1/integrations/linear/callback
# Optional github connection
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
GITHUB_REDIRECT_URI=http://localhost:4100/v1/integrations/github/callback
# Optional slack connection
SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
SLACK_REDIRECT_URI=http://localhost:4100/v1/integrations/slack/callback
# iCloud uses user-supplied app-specific passwords; no OAuth app is needed.
OAUTH_STATE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET_GENERATED_BY_OPENSSL
MOBILE_REDIRECT_URI=veylo:///
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
# Start local Laya with `laya-serve`; OpenAI makes the final interpretation.
# Defaults to http://127.0.0.1:8000. Set a key only for a protected endpoint.
# LAYA_API_KEY=YOUR_LAYA_API_KEY
# LAYA_API_URL=http://127.0.0.1:8000
LAYA_MODEL=typed-decisions
# Optional; set this only when Expo push security is enabled for the EAS project.
# EXPO_ACCESS_TOKEN=YOUR_EXPO_PUSH_ACCESS_TOKEN
# Optional until browser push is enabled; generate a pair with
# `npm exec -w @veylo/worker -- web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Optional until browser push is enabled; then set the same key on API and worker.
# Generate with `openssl rand -hex 32` and uncomment on both API and worker:
# PUSH_SUBSCRIPTION_ENCRYPTION_KEY=
# Optional locally; generate with `openssl rand -hex 32` before enabling metrics.
# METRICS_TOKEN=
WORKER_CONCURRENCY=4
