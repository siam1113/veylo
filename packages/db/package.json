{
  "name": "@veylo/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/migrate.ts",
    "test": "tsx --test test/*.test.ts",
    "test:db": "tsx test/setup-auth.ts && npm run db:migrate && npm run test"
  },
  "dependencies": {
    "@veylo/domain": "*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
